# =============================================================================
# Dots Backend — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
#
# NEVER commit .env with real credentials. Only this template is tracked by git.
# =============================================================================

# --- Flask Core ---
# Generate strong keys with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_flask_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# --- JWT Token Expiration (optional — defaults shown) ---
# JWT_ACCESS_TOKEN_HOURS=24    # Access token lifetime in hours (default: 24)
# JWT_REFRESH_TOKEN_DAYS=30    # Refresh token lifetime in days (default: 30)

# --- Domain (for email verification links) ---
# Local:      localhost:8080
# Production: yourdomain.com
CURRENT_DOMAIN=localhost:8080

# --- Database (PostgreSQL) ---
# Local:      postgresql://postgres:password@localhost:5432/pi_booth_db
# Production: Provided by your cloud platform (e.g., Railway auto-injects DATABASE_URL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/pi_booth_db

# --- Redis ---
# Local:      redis://localhost:6379/0
# Production: Provided by your cloud platform
REDIS_URL=redis://localhost:6379/0

# --- MinIO (S3-compatible Object Storage) ---
# Local: use 'localhost:9000' or 'minio' as host if using docker-compose
# Production: use your cloud MinIO endpoint
MINIO_PRIVATE_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- SendGrid (Email Delivery) ---
# 1. Create a free account at https://sendgrid.com
# 2. Go to Settings > API Keys > Create API Key
# 3. Give it "Full Access" or at least "Mail Send" permissions
# 4. Copy the key (starts with "SG.") and paste it below
# 5. Set MAIL_DEFAULT_SENDER to a verified sender email in your SendGrid account
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
MAIL_DEFAULT_SENDER=your-verified-sender@example.com

# --- Email Verification ---
# "True"  = Users must verify their email before logging in
# "False" = Users can login immediately after registration (useful for development)
VERIFY_EMAILS=True

# --- Internal Secrets ---
# Used for admin/debug endpoints. Generate with: python -c "import secrets; print(secrets.token_hex(16))"
VERIFICATION_SECRET=your_verification_secret_here
